# Token do bot, criado no @BotFather (obrigatório)
TELEGRAM_BOT_TOKEN=

# Para onde enviar: @seu_canal, ID de grupo (-100...) ou seu ID. Vários separados por vírgula.
# Opcional no modo "run": quem mandar /start também passa a receber.
TELEGRAM_CHAT_ID=

# Link da comunidade que acompanha cada mensagem (opcional)
COMMUNITY_URL=

# Só avisar concursos destes estados, além dos nacionais (opcional). Ex.: SP,MS
UFS=

# Máximo de concursos por rodada e intervalo entre rodadas no modo "run"
MAX_ENVIO=10
INTERVALO_HORAS=6
